    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
    items.forEach(function (el, i) {
      el.classList.add('reveal');
      io.observe(el);
    });
  }

  // Progress bar and highlight of the current section in the top bar
  var bar = document.getElementById('progress');
  var links = document.querySelectorAll('.topnav a');
  var nav = document.querySelector('.topnav ul');
  var sections = [];
  links.forEach(function (a) {
    var sec = document.querySelector(a.getAttribute('href'));
    if (sec) sections.push({ a: a, sec: sec });
  });
  var current = null, ticking = false;

  function update() {
    ticking = false;
    var h = root.scrollHeight - window.innerHeight;
    bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';

    var active = null;
    sections.forEach(function (o) {
      if (o.sec.getBoundingClientRect().top <= 140) active = o;
    });
    if (window.innerHeight + window.scrollY >= root.scrollHeight - 4 && sections.length) {
      active = sections[sections.length - 1];
    }
    if (active && active !== current) {
      links.forEach(function (a) { a.classList.remove('active'); a.removeAttribute('aria-current'); });
      active.a.classList.add('active');
      active.a.setAttribute('aria-current', 'true');
      current = active;
      var left = active.a.getBoundingClientRect().left - nav.getBoundingClientRect().left + nav.scrollLeft;
      nav.scrollTo({ left: left - nav.clientWidth / 2 + active.a.clientWidth / 2, behavior: 'smooth' });
    } else if (!active && current) {
      links.forEach(function (a) { a.classList.remove('active'); a.removeAttribute('aria-current'); });
      current = null;
    }
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  window.addEventListener('resize', update);
  update();
})();
</script>
</body>
</html>
