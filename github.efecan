<style>
  :root {
    --bg: #fbf3ea;
    --card: #fffdfa;
    --text: #231a15;
    --muted: #5b4d44;
    --line: #ead9c9;
    --accent: #b13e14;
    --on-accent: #ffffff;
    --glow1: rgba(255, 170, 90, .38);
    --glow2: rgba(255, 120, 110, .22);
    --glow3: rgba(255, 205, 90, .32);
    --dot: rgba(177, 62, 20, .12);
    --nav: rgba(255, 253, 250, .86);
    --shadow: 0 10px 40px rgba(90, 50, 20, .12);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1310;
      --card: #261c17;
      --text: #f6ece4;
      --muted: #c4b0a2;
      --line: #43342b;
      --accent: #ff9b73;
      --on-accent: #231a15;
      --glow1: rgba(255, 140, 70, .22);
      --glow2: rgba(255, 100, 100, .16);
      --glow3: rgba(255, 190, 80, .14);
      --dot: rgba(255, 155, 115, .10);
      --nav: rgba(38, 28, 23, .88);
      --shadow: 0 10px 40px rgba(0, 0, 0, .45);
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background:
      radial-gradient(40rem 28rem at 8% -5%, var(--glow1), transparent 70%),
      radial-gradient(34rem 26rem at 100% 12%, var(--glow2), transparent 70%),
      radial-gradient(38rem 30rem at 50% 105%, var(--glow3), transparent 70%),
      radial-gradient(var(--dot) 1.2px, transparent 1.4px) 0 0 / 22px 22px,
      var(--bg);
    background-attachment: fixed;
    color: var(--text);
    font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
  }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  .topnav {
    position: sticky; top: 0; z-index: 10;
    background: var(--nav);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topnav ul {
    list-style: none; margin: 0 auto; padding: .5rem 1rem; max-width: 50rem;
    display: flex; gap: .4rem; overflow-x: auto; white-space: nowrap;
  }
  .topnav a {
    display: inline-block; padding: .45rem .9rem; min-height: 2.75rem; line-height: 1.85rem;
    border-radius: 999px; text-decoration: none; font-weight: 600; color: var(--text);
    border: 1px solid transparent;
  }
  .topnav a:hover { background: var(--card); border-color: var(--accent); color: var(--accent); }

  main {
    max-width: 48rem; margin: 1.75rem auto 3rem; padding: 2.5rem 1.75rem 3rem;
    background: var(--card); border: 1px solid var(--line); border-radius: 1rem;
    box-shadow: var(--shadow);
  }
  @media (max-width: 40rem) {
    main { margin: 0; border-radius: 0; border-left: 0; border-right: 0; padding: 2rem 1.25rem 3rem; }
  }
  section { scroll-margin-top: 4.5rem; }

  .progress {
    position: fixed; top: 0; left: 0; height: 4px; width: 0; z-index: 20;
    background: linear-gradient(90deg, var(--accent), #f2a33a);
  }
  .topnav a.active { background: var(--accent); color: var(--on-accent); }

  .js .reveal {
    opacity: 0; transform: translateY(26px);
    transition: opacity .65s ease, transform .65s cubic-bezier(.2, .7, .2, 1);
  }
  .js .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .js .reveal { opacity: 1; transform: none; transition: none; }
    .progress { transition: none; }
  }
  .totop { margin: 2.5rem 0 0; text-align: right; }
  a { color: var(--accent); }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  h1 { font-size: 2.25rem; line-height: 1.15; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .tagline { margin: 0 0 .75rem; color: var(--muted); font-size: 1.1rem; }
  .contact { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }

  h2 {
    font-size: 1.15rem;
    margin: 2.5rem 0 .75rem;
    padding-bottom: .35rem;
    border-bottom: 3px solid transparent;
    border-image: linear-gradient(90deg, var(--accent), #f2a33a 60%, transparent) 1;
  }
  h3 { font-size: 1.05rem; margin: 0; }
  .entry { margin: 0 0 1.5rem; }
  .entry-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .1rem 1rem; }
  .meta { color: var(--muted); margin: 0; }
  ul.bullets { margin: .5rem 0 0; padding-left: 1.2rem; }
  ul.bullets li { margin: 0 0 .35rem; }

  dl.skills { margin: 0; }
  dl.skills dt { font-weight: 600; margin-top: .75rem; }
  dl.skills dd { margin: 0; }

  .hero { display: flex; align-items: center; gap: 1.5rem 2rem; flex-wrap: wrap; }
  .avatar {
    width: 9.5rem; height: 9.5rem; flex: none; border-radius: 50%; object-fit: cover;
    border: 4px solid var(--card); box-shadow: 0 0 0 3px var(--accent), var(--shadow);
  }
  .hero-text { flex: 1 1 18rem; min-width: 0; }
  @media (max-width: 40rem) { .hero { flex-direction: column; text-align: center; } .contact { justify-content: center; } }
  .intro { margin: 1rem 0 0; font-size: 1.1rem; max-width: 40rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.25rem 0 0; }
  .btn {
    display: inline-block; padding: .65rem 1.2rem; min-height: 2.75rem; border-radius: 999px;
    border: 2px solid var(--accent); color: var(--accent); background: transparent;
    font-weight: 600; text-decoration: none;
  }
  .btn:hover { background: var(--accent); color: var(--on-accent); }
  .btn.primary { background: var(--accent); color: var(--on-accent); }
  .btn.primary:hover { filter: brightness(1.1); }

  figure.diagram { margin: 1rem 0 0; border: 1px solid var(--line); border-radius: .6rem; overflow: hidden; }
  figure.diagram figcaption { margin: 0; padding: .6rem .9rem; color: var(--muted); font-size: .95rem; background: var(--card); }
  figure.poster { margin: 1rem 0 0; }
  figure.poster img { display: block; width: 100%; max-width: 32rem; height: auto; border: 1px solid var(--line); }
  figure.poster figcaption { margin-top: .5rem; color: var(--muted); font-size: .95rem; }

  @media print {
    :root { --bg: #fff; --card: #fff; --text: #000; --muted: #333; --line: #999; --accent: #000; }
    body { background: #fff; }
    .topnav, .totop { display: none; }
    h2 { border-image: none; border-bottom: 2px solid #999; }
    main { padding: 0; margin: 0; max-width: none; border: 0; box-shadow: none; border-radius: 0; }
    .actions, .progress { display: none; }
    .js .reveal { opacity: 1 !important; transform: none !important; }
    a { text-decoration: none; }
    .entry { break-inside: avoid; }
  }
</style>
</head>
